# Veuillez copier ce fichier, en modifier les valeurs et appeler config.sh -f <.env>

#========
# CONFIG
#========

if ! [ -v _PWD ]; then
	_PWD=".."
fi

if ! [ -v DOMAINE_GLOBAL ]; then
	DOMAINE_GLOBAL="ctf"
fi

DEFIS_CATEGORISES=1 #obligatoire dans cette version du script
SYMLINKS=1 #créer des symlinks vers les bons fichiers
NOM_CTF="Super CTF"
LIEN_CTFD="https://ctfd.${DOMAINE_GLOBAL}"
DOSSIER_DEFIS="${_PWD}/defis"
FICHIER_EQUIPES="${_PWD}/comptes_utilisateurs.json"
ICONE="./web/logo-small.svg"
LOGO="./web/logo-large.svg"

PORT=8000

#=========
# SERVEUR
#=========

RACINE_SERVEUR="/var/www"
ICONE_SERVEUR="$(basename $ICONE)"
LOGO_SERVEUR="$(basename $LOGO)"