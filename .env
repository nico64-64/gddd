DEFIS_CATEGORISES=1 #obligatoire dans cette version du script
SYMLINKS=0 #créer des symlinks vers les bons fichiers
NOM_CTF="\&lt;/UCTF 2026\&gt;"
LIEN_CTFD="https://ctfd.uctf.ctf"
DOSSIER_DEFIS="${_PWD}/defis"
FICHIER_EQUIPES="${_PWD}/coordination/comptes_utilisateurs.json"
ICONE="${_PWD}/ctfd/ctfd-fichiers/Logo1.webp"
LOGO="${_PWD}/ctfd/ctfd-fichiers/Logo2.webp"

IP="$(cat "${_PWD}/coordination/machines_services.json" | jq -r '.gddd.ip')"